# ===== 复制为 .env 并填入真实值（.env 不要提交/外发时记得脱敏）=====

# charmland LLM（必需）
CHARMLAND_API_KEY=sk-xxx

# Alpaca Paper Trading（必需）
# 在 https://app.alpaca.markets/paper/dashboard/overview 获取
ALPACA_API_KEY=PKXXX
ALPACA_SECRET_KEY=xxx

# Finnhub（可选，财报日历/基本面补充）
FINNHUB_API_KEY=

# 飞书自定义机器人 Webhook（可选，异常警报/日报推送）
FEISHU_WEBHOOK=

# 仪表盘端口（可选，默认 8000）
DASHBOARD_PORT=8100
